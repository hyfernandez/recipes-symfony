{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
    body { font-family: system-ui, sans-serif; background: #faf8f5; color: #222; margin: 0; }
    header { background: #fff; border-bottom: 1px solid #e5e0d8; padding: 12px 24px; display: flex; gap: 16px; align-items: center; }
    header .spacer { flex: 1; }
    main { max-width: 900px; margin: 24px auto; padding: 0 16px; }
    a { color: #b34700; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #eee; font-size: 14px; }
    .btn { display: inline-block; padding: 6px 12px; background: #b34700; color: #fff; border: 0; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 14px; }
    .btn-danger { background: #a11; }
    .btn-link { background: none; color: #b34700; padding: 0; }
    .flash { padding: 10px 14px; border-radius: 6px; margin-bottom: 12px; }
    .flash-success { background: #e6f4ea; border: 1px solid #b7dfc2; }
    .flash-error { background: #fde8e8; border: 1px solid #f5b5b5; }
    form label { display: block; margin-top: 12px; font-weight: 600; font-size: 14px; }
    form input[type=text], form input[type=number], form textarea, form select { width: 100%; padding: 8px; box-sizing: border-box; margin-top: 4px; }
    form ul { color: #a11; margin: 4px 0; padding-left: 18px; font-size: 13px; }
    form div[id$="_tags"] label { display: inline; font-weight: normal; margin-right: 12px; }
    form div[id$="_tags"] input { width: auto; }
    .inline { display: inline; }
</style>
{% endblock %}

{% block body %}
<header>
    <strong>Admin</strong>
    <a href="{{ path('admin_recipe_index') }}">Recipes</a>
    <a href="{{ path('recipe_index') }}">View catalog</a>
    <span class="spacer"></span>
    <span>{{ app.user.userIdentifier }}</span>
    <a href="{{ path('app_logout') }}">Log out</a>
</header>
<main>
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ type }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</main>
{% endblock %}
