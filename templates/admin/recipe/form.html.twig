{% extends 'admin/layout.html.twig' %}

{% block title %}{{ title }} · Admin{% endblock %}

{% block content %}
    <h1>{{ title }}</h1>

    {% if recipe is defined and recipe.imageFilename %}
        <p>Current photo:<br><img src="/uploads/{{ recipe.imageFilename }}" alt="{{ recipe.title }}" style="max-width:200px;"></p>
    {% endif %}

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <p>
            <button type="submit" class="btn">Save</button>
            <a href="{{ path('admin_recipe_index') }}">Cancel</a>
        </p>
    {{ form_end(form) }}
{% endblock %}
