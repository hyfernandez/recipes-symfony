{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block stylesheets %}
<style>
    body { font-family: system-ui, sans-serif; background: #faf8f5; color: #222; }
    main { max-width: 360px; margin: 60px auto; padding: 0 16px; }
    label { display: block; margin-top: 12px; font-size: 14px; }
    input { width: 100%; padding: 8px; box-sizing: border-box; margin-top: 4px; }
    button { margin-top: 16px; padding: 8px 16px; background: #b34700; color: #fff; border: 0; border-radius: 6px; cursor: pointer; }
    .error { background: #fde8e8; border: 1px solid #f5b5b5; padding: 8px 12px; border-radius: 6px; }
    a { color: #b34700; }
</style>
{% endblock %}

{% block body %}
<main>
    <h1>Log in</h1>

    {% if error %}
        <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post">
        <label for="username">Email</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

        <label for="password">Password</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Log in</button>
    </form>

    <p><a href="{{ path('recipe_index') }}">&laquo; Back to the catalog</a></p>
</main>
{% endblock %}
